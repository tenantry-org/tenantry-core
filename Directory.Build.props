<Project>

  <Import Project="eng/common/Build.props" />

  <!-- This repository's own settings. Projects under src/, tests/ and samples/ add their folder's Directory.Build.props. -->
  <PropertyGroup>
    <RepositoryUrl>https://github.com/tenantry-org/tenantry-core</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- As in LICENSE -->
    <Copyright>Copyright 2026 Oliver James McNally</Copyright>
    <!-- The README each package carries, for NuGet.org rather than the repository: the package's id and description,
         then eng/package-readme.md, which uses absolute links. Directory.Build.targets writes it when the package is
         packed. -->
    <TenantryPackageReadmeBody>$(MSBuildThisFileDirectory)eng/package-readme.md</TenantryPackageReadmeBody>
    <TenantryPackageReadme>$(MSBuildProjectDirectory)/obj/package-readme.md</TenantryPackageReadme>
    <!-- The last release, which pack checks each package's API against (eng/common/Build.targets). Raise it after each
         release (RELEASING.md). -->
    <TenantryPackageBaseline>0.6.0</TenantryPackageBaseline>
    <!-- The minor master works towards. Releases are tagged on release branches, on commits master does not contain, so
         master's last reachable tag stays behind; this keeps master's packages versioned X.Y.0-alpha.0.N above every
         release, and ci.yml publishes them only in that form. Raise it on master after release/X.Y is cut
         (RELEASING.md). A tagged commit takes its tag's version. -->
    <MinVerMinimumMajorMinor>0.8</MinVerMinimumMajorMinor>
  </PropertyGroup>

</Project>

<Project>

  <!--
    Package versions both repositories use, imported by each one's Directory.Packages.props (central package
    management, for src and tests; samples declare their own versions). Core is the source (see Build.props), and its
    Dependabot maintains the ones with a single exact version; Pro's ignores them.

    A version range ("[8.0.31, 9.0.0)") is what a package publishes: its floor is the oldest version supported, which
    some test must resolve (scripts/check-dependency-floors.cs). A per-framework band stays in its framework's major.
    Microsoft.Extensions.* take a minimum only (see scripts/check-package-ranges.cs).
  -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />

    <!-- Test tooling -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!--
    The floors of each target framework's Microsoft packages, for the ranges below and in each repository's
    Directory.Packages.props: Microsoft.Extensions.* from the framework's first release, EF Core from the release the
    tests run against, and the framework's band ending at the next major. Set in a framework's own evaluation only,
    which every project here has, since they all multi-target.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <MicrosoftExtensionsFloor>8.0.0</MicrosoftExtensionsFloor>
    <EfCoreFloor>8.0.31</EfCoreFloor>
    <FrameworkNextMajor>9.0.0</FrameworkNextMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <MicrosoftExtensionsFloor>9.0.0</MicrosoftExtensionsFloor>
    <EfCoreFloor>9.0.20</EfCoreFloor>
    <FrameworkNextMajor>10.0.0</FrameworkNextMajor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <MicrosoftExtensionsFloor>10.0.0</MicrosoftExtensionsFloor>
    <EfCoreFloor>10.0.12</EfCoreFloor>
    <FrameworkNextMajor>11.0.0</FrameworkNextMajor>
  </PropertyGroup>

  <!-- The .NET 11 preview lane only (IncludeNet11) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <MicrosoftExtensionsFloor>$(Net11PreviewVersion)</MicrosoftExtensionsFloor>
    <EfCoreFloor>$(Net11PreviewVersion)</EfCoreFloor>
    <FrameworkNextMajor>12.0.0</FrameworkNextMajor>
  </PropertyGroup>

  <ItemGroup Condition="'$(EfCoreFloor)' != ''">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[$(EfCoreFloor), $(FrameworkNextMajor))" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[$(EfCoreFloor), $(FrameworkNextMajor))" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="[$(EfCoreFloor), $(FrameworkNextMajor))" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[$(MicrosoftExtensionsFloor), )" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="[$(MicrosoftExtensionsFloor), )" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="[$(MicrosoftExtensionsFloor), )" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[$(MicrosoftExtensionsFloor), )" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="[$(MicrosoftExtensionsFloor), )" />
    <!-- HybridCache's base type arrived in 9.0, which supports net8.0 (scripts/check-package-ranges.cs allows it) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="[$(MicrosoftExtensionsFloor), )" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="[9.0.0, )" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[8.0.4, 9.0.0)" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="[8.0.2, 9.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="[9.0.0, 10.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.3, 11.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.1.1" />
  </ItemGroup>

</Project>

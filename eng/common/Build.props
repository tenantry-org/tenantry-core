<Project>

  <!--
    Settings shared by Tenantry Core and Tenantry Pro, imported by each repository's Directory.Build.props. Core is the
    source: Pro copies the files eng/common/shared-files.txt lists with scripts/sync-shared-files.sh. Pro's CI fails
    when they differ from the Core it pins; its latest dependency lane reports a difference from Core's master.
  -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>Tenantry Contributors</Authors>
    <!-- CI builds are deterministic: PDBs and SourceLink record /_/ instead of the runner's source path -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      The .NET 11 release the net11.0 builds take their Microsoft packages from, and their floor: 11.0.0, released on
      10 November 2026. Never a prerelease: a stable package cannot depend on one (NU5104, an error here), and
      scripts/cut-release.sh refuses one. global.json names the matching SDK.
    -->
    <Net11Version>11.0.0</Net11Version>
    <!-- The latest dependency lane floats central versions (see Build.targets) -->
    <CentralPackageFloatingVersionsEnabled Condition="'$(LatestDependencies)' == 'true'">true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExcludeFromCodeCoverage)' == 'true'">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

</Project>

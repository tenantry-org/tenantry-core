<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>ASP.NET Core integration for Tenantry: resolves each request's tenant (from a header, the host, a subdomain, a route value, a claim or the query string), with middleware, [RequireTenant] and [AllowMissingTenant] for endpoints, and access validators that check the caller may act for the tenant.</PackageDescription>
    <PackageTags>multi-tenancy;multitenancy;multi-tenant;aspnetcore;middleware;tenant-resolution;saas;tenant-isolation;tenantry</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenantry.Core\Tenantry.Core.csproj" IncludeAssets="compile;runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tenantry.AspNetCore.Tests"/>
    <InternalsVisibleTo Include="Tenantry.IntegrationTests"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

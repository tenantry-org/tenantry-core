<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>EF Core integration for Tenantry: tenant query filters, stamping and checking of tenant-owned writes, guarded bulk updates, DbContext pooling (including with a database per tenant), and an optional MultiTenantDbContext base class.</PackageDescription>
    <PackageTags>multi-tenancy;efcore;aspnetcore;saas;tenantry;tenant-isolation</PackageTags>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenantry.Core\Tenantry.Core.csproj" IncludeAssets="compile;runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tenantry.EfCore.Tests"/>
    <InternalsVisibleTo Include="Tenantry.IntegrationTests"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[8.0.31, 9.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.31, 9.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.2, )" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[9.0.20, 10.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[9.0.20, 10.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.20, )" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[10.0.12, 11.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.12, 11.0.0)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.12, )" />
  </ItemGroup>

  <!-- The .NET 11 preview lane only (IncludeNet11). The DI abstractions come with the shared framework there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[$(Net11PreviewVersion), 12.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[$(Net11PreviewVersion), 12.0.0)" />
  </ItemGroup>

</Project>

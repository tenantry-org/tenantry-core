<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>EF Core integration for Tenantry: options.UseTenantry() gives any DbContext, pooled or not, tenant query filters, stamping and checking of tenant-owned writes and guarded bulk updates; AddDbContextPerTenantDatabase connects a context to each tenant's own database.</PackageDescription>
    <PackageTags>multi-tenancy;multitenancy;multi-tenant;efcore;entity-framework-core;row-level;database-per-tenant;tenant-isolation;saas;aspnetcore;tenantry</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tenantry.Core\Tenantry.Core.csproj" IncludeAssets="compile;runtime;build;native;contentfiles;analyzers;buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tenantry.EfCore.Tests"/>
    <InternalsVisibleTo Include="Tenantry.IntegrationTests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <!-- The EF Core major each target framework builds against (Directory.Packages.props), and the .NET 11 preview lane's (IncludeNet11) -->
  <PropertyGroup>
    <EfCoreMajor Condition="'$(TargetFramework)' == 'net8.0'">8</EfCoreMajor>
    <EfCoreMajor Condition="'$(TargetFramework)' == 'net9.0'">9</EfCoreMajor>
    <EfCoreMajor Condition="'$(TargetFramework)' == 'net10.0'">10</EfCoreMajor>
    <EfCoreMajor Condition="'$(TargetFramework)' == 'net11.0'">11</EfCoreMajor>
  </PropertyGroup>

  <!-- Code that depends on the EF Core version branches on these, not on the target framework. -->
  <PropertyGroup>
    <DefineConstants Condition="'$(EfCoreMajor)' != '' And $(EfCoreMajor) &gt;= 10">$(DefineConstants);EFCORE10_OR_GREATER</DefineConstants>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>Core of Tenantry, for every host: AddTenantry, the ambient tenant (ITenantContext), tenant stores and their cache, tenant scopes for background work (ITenantScopeFactory), per-tenant connection strings and the ITenantEntity marker.</PackageDescription>
    <PackageTags>multi-tenancy;aspnetcore;saas;tenantry;tenant-isolation</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tenantry.Core.Tests"/>
    <InternalsVisibleTo Include="Tenantry.EfCore.Tests"/>
  </ItemGroup>

  <!-- Not in the .NET 11 preview lane (IncludeNet11), where the DI abstractions come with the shared framework -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>

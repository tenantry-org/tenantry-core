<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageDescription>Core of Tenantry, multi-tenancy for .NET, for every host: AddTenantry, the ambient tenant (ITenantContext), tenant stores and their cache, tenant scopes for background work (ITenantScopeFactory), per-tenant connection strings and the ITenantEntity marker.</PackageDescription>
    <PackageTags>multi-tenancy;multitenancy;multi-tenant;saas;tenant-isolation;aspnetcore;tenantry</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Core's types are in the namespace Tenantry, not Tenantry.Core, so applications need one using for them -->
    <RootNamespace>Tenantry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tenantry.Core.Tests"/>
    <InternalsVisibleTo Include="Tenantry.EfCore.Tests"/>
  </ItemGroup>

  <!-- Not in the .NET 11 preview lane (IncludeNet11), where the DI abstractions come with the shared framework -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>

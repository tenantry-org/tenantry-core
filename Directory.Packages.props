<Project>

  <!-- Central package management for src and tests (see eng/common/Packages.props); this repository's own versions follow. -->
  <Import Project="eng/common/Packages.props" />

  <ItemGroup Condition="'$(MicrosoftExtensionsFloor)' != ''">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="[$(MicrosoftExtensionsFloor), )" />
  </ItemGroup>

  <!-- The analyzers (analyzers/): Roslyn as the .NET 8 SDK ships it, the oldest SDK an application builds with, held
       there (a newer one would not load in that SDK's compiler); and Roslyn's testing libraries for their tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[4.8.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[4.8.0]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
  </ItemGroup>

  <!-- A provider that is not relational, for the tests that Tenantry works without one; and ASP.NET Core Identity's EF Core
       stores, released with EF Core, for the integration tests with Identity -->
  <ItemGroup Condition="'$(EfCoreFloor)' != ''">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="[$(EfCoreFloor), $(FrameworkNextMajor))" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="[$(EfCoreFloor), $(FrameworkNextMajor))" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Per-tenant authentication tests (ConfigurePerTenant<JwtBearerOptions>) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[8.0.31, 9.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[8.0.0, 9.0.0)" />
    <!-- HybridCache's implementation, for Tenantry.Caching's tests with it: 9.3.0 is its first release -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="[9.3.0, 10.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <!-- Per-tenant authentication tests (ConfigurePerTenant<JwtBearerOptions>) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[9.0.20, 10.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[9.0.0, 10.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="[9.3.0, 10.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Per-tenant authentication tests (ConfigurePerTenant<JwtBearerOptions>) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Oracle's MySQL provider: Pomelo has no EF Core 10 release -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[10.0.12, 11.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="[10.0.0, 11.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <!-- Per-tenant authentication tests (ConfigurePerTenant<JwtBearerOptions>) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[$(Net11PreviewVersion), 12.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(Net11PreviewVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="[$(Net11PreviewVersion), 12.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="[10.0.0, 12.0.0)" />
  </ItemGroup>

</Project>

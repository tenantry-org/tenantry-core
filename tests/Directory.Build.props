<Project>

  <!-- Tests: every supported target framework, no docs, excluded from coverage. Shared with Tenantry Pro (eng/common/shared-files.txt). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- xUnit.net v3 test projects are executables, which run on Microsoft Testing Platform (global.json opts `dotnet test`
         into it); a support library sets OutputType back to Library -->
    <OutputType>Exe</OutputType>
    <!-- NuGet's audit (NU1901 to NU1904) stays a warning here: an advisory against a package only the tests use,
         such as one Roslyn's testing libraries or a database driver bring, would otherwise stop every locked restore
         until it is raised. src, the analyzers, the samples and the package consumer still fail on one, and Dependabot
         reports it. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- The test tooling, in every test project (a support library sets IsTestProject to false) -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

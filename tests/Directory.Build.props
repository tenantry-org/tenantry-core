<Project>

  <!-- Tests: every supported target framework, no docs, excluded from coverage. Shared with Tenantry Pro (eng/common/shared-files.txt). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeNet11)' == 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- xUnit.net v3 test projects are executables, which run on Microsoft Testing Platform (global.json opts `dotnet test`
         into it); a support library sets OutputType back to Library -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The test tooling, in every test project (a support library sets IsTestProject to false) -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

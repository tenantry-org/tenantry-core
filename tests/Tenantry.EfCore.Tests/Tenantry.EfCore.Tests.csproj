<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <!-- Code that depends on the EF Core version branches on this, as the package does (one EF Core major per framework, Directory.Packages.props). -->
  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">$(DefineConstants);EFCORE10_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tenantry.Core\Tenantry.Core.csproj" />
    <ProjectReference Include="..\..\src\Tenantry.EfCore\Tenantry.EfCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Conformance.cs" Link="Shared\Conformance.cs" />
  </ItemGroup>

</Project>

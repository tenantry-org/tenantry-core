<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzers Tenantry.Core, Tenantry.EfCore and Tenantry.AspNetCore carry, run over code that uses the real
       Tenantry, EF Core and ASP.NET Core assemblies of each target framework (Verify.cs) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- Roslyn's testing libraries allow the vulnerable System.Security.Cryptography.Pkcs 9.0.6: raise it -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\Tenantry.Core.Analyzers\Tenantry.Core.Analyzers.csproj" />
    <ProjectReference Include="..\..\analyzers\Tenantry.EfCore.Analyzers\Tenantry.EfCore.Analyzers.csproj" />
    <ProjectReference Include="..\..\analyzers\Tenantry.AspNetCore.Analyzers\Tenantry.AspNetCore.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Tenantry.Core\Tenantry.Core.csproj" />
    <ProjectReference Include="..\..\src\Tenantry.AspNetCore\Tenantry.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Tenantry.EfCore\Tenantry.EfCore.csproj" />
  </ItemGroup>

</Project>

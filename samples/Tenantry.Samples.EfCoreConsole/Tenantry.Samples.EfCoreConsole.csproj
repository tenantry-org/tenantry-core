<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <!-- At the EF Core release, as the Microsoft.Extensions packages EF Core brings are, rather than the central floor -->
      <PackageReference Include="Microsoft.Extensions.Hosting" VersionOverride="$(EfCoreFloor)" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Tenantry.Core\Tenantry.Core.csproj" />
      <ProjectReference Include="..\..\src\Tenantry.EfCore\Tenantry.EfCore.csproj" />
    </ItemGroup>

</Project>
